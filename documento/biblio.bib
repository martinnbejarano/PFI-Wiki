%
% Formato de referencia:
%
% @article{ClaveUnica,
%   author    = {Apellido, Nombre and Apellido2, Nombre2},
%   title     = {{Título exacto del artículo}},
%   journal   = {Nombre de la revista},
%   year      = {2023},
%   volume    = {10},
%   number    = {2},
%   pages     = {1--15},
%   doi       = {10.xxxx/xxxxx},
%   note      = {Consultado: 2026-XX-XX},
% }
%
% @inproceedings{ClaveUnica,
%   author    = {Apellido, Nombre},
%   title     = {{Título}},
%   booktitle = {Proceedings of ...},
%   year      = {2023},
%   pages     = {1--10},
%   doi       = {10.xxxx/xxxxx},
% }
%
% Convenciones:
% - Dobles llaves en títulos para preservar mayúsculas/minúsculas
% - Autores como "Apellido, Nombre" para evitar errores con nombres compuestos
% - DOI como campo propio (no en URL)
% - Actualizar el campo "note" si la referencia es online
