<mxfile host="app.diagrams.net" type="device">
  <diagram id="c4-componentes" name="C4 N3 - Componentes de la API">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2180" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="Diagrama de componentes — API REST (C4 — nivel 3)" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="limite" value="API REST · Python + FastAPI · Railway" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#8a949e;dashed=1;fontSize=12;fontStyle=2;spacingTop=6;fontColor=#5b6570;" vertex="1" parent="1">
          <mxGeometry x="190" y="110" width="1550" height="780" as="geometry" />
        </mxCell>

        <mxCell id="ep_analisis" value="&lt;b&gt;Endpoint de análisis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Recibe los pedidos de la extensión" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="220" y="160" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="ep_b2b" value="&lt;b&gt;Endpoint de clasificación B2B&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Contrato público de la API vendida" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;Autenticación y cuotas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Valida la clave, descuenta consumo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="1350" y="160" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="orq" value="&lt;b&gt;Orquestador de análisis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Decide qué módulos ejecutar según el flujo: en el automático solo el Módulo 1;&lt;br&gt;en el de a demanda, los Módulos 2, 3 y 4. Marca el resultado como parcial&lt;br&gt;si un módulo falla." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="220" y="290" width="750" height="105" as="geometry" />
        </mxCell>

        <mxCell id="cache" value="&lt;b&gt;Capa de caché&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Resuelve el tuit ya analizado&lt;br&gt;y vigente sin recomputar" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="1010" y="290" width="300" height="105" as="geometry" />
        </mxCell>

        <mxCell id="repos" value="&lt;b&gt;Repositorios&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Único punto de acceso&lt;br&gt;a la base de datos" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="1350" y="290" width="330" height="105" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="&lt;b&gt;M1 · Clasificador NLP&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Cliente de inferencia.&lt;br&gt;Devuelve score_nlp ∈ [0,1]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="220" y="450" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m2" value="&lt;b&gt;M2 · Señales de la cuenta autora&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Regresión logística sobre señales&lt;br&gt;públicas. Devuelve score_source" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="600" y="450" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m4" value="&lt;b&gt;M4 · Ensamblador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Combina los tres scores, aplica umbrales&lt;br&gt;y redacta la justificación con el&lt;br&gt;enlace de cada razón" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m3box" value="&lt;b&gt;M3 · Contraste semántico&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#c07a1d;fontSize=12;spacingTop=6;fontColor=#8a5310;" vertex="1" parent="1">
          <mxGeometry x="990" y="440" width="730" height="400" as="geometry" />
        </mxCell>

        <mxCell id="extractor" value="&lt;b&gt;Extractor de afirmaciones&lt;/b&gt;&lt;br&gt;NER + clasificación por tipo:&lt;br&gt;normativa, económico, salud, educación" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="1010" y="485" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="enrutador" value="&lt;b&gt;Enrutador de fuentes oficiales&lt;/b&gt;&lt;br&gt;&lt;i&gt;prioridad 1&lt;/i&gt;&lt;br&gt;Rutea según el tipo de afirmación&lt;br&gt;y busca sobre el índice local" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#e9f6ef;strokeColor=#1a7a4c;" vertex="1" parent="1">
          <mxGeometry x="1370" y="485" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="medios" value="&lt;b&gt;Cliente de medios de referencia&lt;/b&gt;&lt;br&gt;&lt;i&gt;prioridad 2&lt;/i&gt;&lt;br&gt;Consulta los 5 medios y mide consenso" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#e9f6ef;strokeColor=#1a7a4c;" vertex="1" parent="1">
          <mxGeometry x="1010" y="585" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="vectorial" value="&lt;b&gt;Buscador vectorial&lt;/b&gt;&lt;br&gt;&lt;i&gt;prioridad 3&lt;/i&gt;&lt;br&gt;Verificaciones previas por similitud&lt;br&gt;(pgvector, índice HNSW)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#f3faf6;strokeColor=#1a7a4c;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1370" y="585" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="evaluador" value="&lt;b&gt;Evaluador de postura&lt;/b&gt;&lt;br&gt;Clasifica cada fuente como corrobora, contradice o neutral, y sintetiza&lt;br&gt;score_similarity más el arreglo de fuentes vinculadas" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="1010" y="690" width="690" height="75" as="geometry" />
        </mxCell>

        <mxCell id="hf" value="&lt;b&gt;Hugging Face&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Externo]&lt;/i&gt;&lt;br&gt;Inferencia XLM-T" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#f1f3f5;strokeColor=#8a949e;" vertex="1" parent="1">
          <mxGeometry x="220" y="950" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fuentes" value="&lt;b&gt;Fuentes oficiales, medios y verificadores&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Externos]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#e9f6ef;strokeColor=#1a7a4c;" vertex="1" parent="1">
          <mxGeometry x="1010" y="950" width="690" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ingesta" value="&lt;b&gt;Ingesta programada&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: tarea de Railway]&lt;/i&gt;&lt;br&gt;Recorre las seis fuentes oficiales respetando&lt;br&gt;el crawl-delay de cada sitio e indexa los&lt;br&gt;documentos nuevos (RF-28). Fuera del&lt;br&gt;camino crítico de toda petición." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1780" y="880" width="340" height="130" as="geometry" />
