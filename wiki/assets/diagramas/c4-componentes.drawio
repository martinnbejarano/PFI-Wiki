<mxfile host="app.diagrams.net" type="device">
  <diagram id="c4-componentes" name="C4 N3 - Componentes de la API">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="Diagrama de componentes — API REST (C4 — nivel 3)" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="30" as="geometry" />
        </mxCell>

        <mxCell id="limite" value="API REST · Python + FastAPI · Railway" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#8a949e;dashed=1;fontSize=12;fontStyle=2;spacingTop=4;fontColor=#5b6570;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1090" height="560" as="geometry" />
        </mxCell>

        <mxCell id="ep1" value="&lt;b&gt;Endpoint de análisis&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Recibe los pedidos de la extensión" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ep2" value="&lt;b&gt;Endpoint de clasificación B2B&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Contrato público de la API vendida" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Autenticación y cuotas&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Valida la clave, descuenta consumo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="100" width="250" height="65" as="geometry" />
        </mxCell>

        <mxCell id="orq" value="&lt;b&gt;Orquestador de análisis&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Decide qué módulos ejecutar según el flujo: en el automático solo el Módulo 1;&#10;en el de a demanda, los Módulos 2, 3 y 4. Marca el resultado como parcial si un módulo falla." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="530" height="75" as="geometry" />
        </mxCell>

        <mxCell id="cache" value="&lt;b&gt;Capa de caché&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Resuelve el tuit ya analizado&#10;y vigente sin recomputar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="200" width="250" height="75" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="&lt;b&gt;M1 · Clasificador NLP&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Cliente de inferencia. Devuelve&#10;score_nlp ∈ [0,1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4e3;strokeColor=#a56a00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;M2 · Credibilidad de fuente&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Regresión logística sobre metadatos&#10;de cuenta. Devuelve score_source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4e3;strokeColor=#a56a00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="405" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;M4 · Ensamblador&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Combina los tres scores, aplica&#10;umbrales y redacta la justificación&#10;con el enlace de cada razón" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4e3;strokeColor=#a56a00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m3" value="M3 · Contraste semántico" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fffdf7;strokeColor=#a56a00;fontSize=12;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="345" y="310" width="535" height="280" as="geometry" />
        </mxCell>
        <mxCell id="m3a" value="&lt;b&gt;Extractor de afirmaciones&lt;/b&gt;&#10;NER + clasificación por tipo:&#10;normativa, económico, salud…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4e3;strokeColor=#a56a00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="365" y="345" width="245" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m3b" value="&lt;b&gt;Enrutador de fuentes oficiales&lt;/b&gt;&#10;&lt;i&gt;prioridad 1&lt;/i&gt;&#10;Rutea según el tipo de afirmación" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#1a7a4c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="345" width="245" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m3c" value="&lt;b&gt;Cliente de medios de referencia&lt;/b&gt;&#10;&lt;i&gt;prioridad 2&lt;/i&gt;&#10;Consulta los 5 medios y mide consenso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#1a7a4c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="365" y="430" width="245" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m3d" value="&lt;b&gt;Buscador vectorial&lt;/b&gt;&#10;&lt;i&gt;prioridad 3&lt;/i&gt;&#10;Verificaciones previas por similitud&#10;(pgvector, índice HNSW)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fbf9;strokeColor=#a8d7bf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="430" width="245" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m3e" value="&lt;b&gt;Evaluador de postura&lt;/b&gt;&#10;Clasifica cada fuente recuperada como corrobora, contradice o neutral,&#10;y sintetiza score_similarity más el arreglo de fuentes vinculadas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4e3;strokeColor=#a56a00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="365" y="515" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="repo" value="&lt;b&gt;Repositorios&lt;/b&gt;&#10;&lt;i&gt;[Componente]&lt;/i&gt;&#10;Único punto de acceso&#10;a la base de datos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="200" width="185" height="90" as="geometry" />
        </mxCell>

        <mxCell id="db" value="&lt;b&gt;PostgreSQL + pgvector&lt;/b&gt;&#10;&lt;i&gt;[Contenedor]&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#8a949e;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="660" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hf" value="&lt;b&gt;Hugging Face&lt;/b&gt;&#10;&lt;i&gt;[Externo]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#8a949e;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="660" width="180" height="55" as="geometry" />
