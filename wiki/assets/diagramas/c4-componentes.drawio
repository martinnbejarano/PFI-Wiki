        <mxCell id="nota" value="El orden interno del Módulo 3 es la jerarquía de evidencia hecha componente: el enrutador de fuentes oficiales y el cliente de medios son los dos caminos siempre activos, y el buscador vectorial de verificaciones previas entra con línea punteada porque es opcional — cuando no hay verificación equivalente, que es el caso frecuente, el contraste no se degrada." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5b6570;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="750" width="860" height="60" as="geometry" />
        </mxCell>

