        <mxCell id="limite" value="API REST · Python + FastAPI · Railway" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#8a949e;dashed=1;fontSize=12;fontStyle=2;spacingTop=6;fontColor=#5b6570;" vertex="1" parent="1">
          <mxGeometry x="190" y="110" width="1330" height="660" as="geometry" />
        </mxCell>

        <mxCell id="ep_analisis" value="&lt;b&gt;Endpoint de análisis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Recibe los pedidos de la extensión" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="220" y="160" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="ep_b2b" value="&lt;b&gt;Endpoint de clasificación para organizaciones&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Contrato público de la API vendida" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;Autenticación y cuotas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Valida la clave, descuenta consumo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="1010" y="160" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="orq" value="&lt;b&gt;Orquestador de análisis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Decide qué módulos ejecutar según el flujo y marca el resultado&lt;br&gt;como parcial si un módulo falla" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="220" y="290" width="640" height="110" as="geometry" />
        </mxCell>

        <mxCell id="repos" value="&lt;b&gt;Repositorios y caché&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Único punto de acceso a la base.&lt;br&gt;Resuelve el análisis vigente sin recomputar" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#eaf1fa;strokeColor=#1b4f8f;" vertex="1" parent="1">
          <mxGeometry x="1010" y="290" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="&lt;b&gt;M1 · Clasificador NLP&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Cliente de inferencia.&lt;br&gt;Devuelve score_nlp ∈ [0,1]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="220" y="470" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="m2" value="&lt;b&gt;M2 · Señales de la cuenta autora&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Regresión logística sobre señales&lt;br&gt;públicas. Devuelve score_source" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="m3" value="&lt;b&gt;M3 · Contraste semántico&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Extrae la afirmación verificable y la contrasta&lt;br&gt;siguiendo la jerarquía de evidencia. Clasifica la&lt;br&gt;postura de cada fuente y devuelve score_similarity" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="1010" y="470" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="m4" value="&lt;b&gt;M4 · Ensamblador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;Combina los tres puntajes, aplica umbrales y redacta&lt;br&gt;la justificación con el enlace de cada razón" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#fdf2e3;strokeColor=#c07a1d;" vertex="1" parent="1">
          <mxGeometry x="560" y="650" width="410" height="105" as="geometry" />
        </mxCell>

