        <mxCell id="nota_hf" value="&lt;b&gt;Por qué la inferencia vive fuera: presupuesto, no memoria.&lt;/b&gt;&lt;br&gt;Railway Hobby no impone techo de RAM: factura por consumo sobre un crédito&lt;br&gt;mensual. Un transformer de ~125M de parámetros residente lo quema en días;&lt;br&gt;bajo demanda se paga por invocación. Son dos cómputos con costo separado&lt;br&gt;— USD 5 y USD 9 — y suman el techo de USD 14 (RNF-14)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="390" height="95" as="geometry" />
        </mxCell>

        <mxCell id="nota_zonas" value="&lt;b&gt;Sobre las zonas 1, 2 y 5.&lt;/b&gt;&lt;br&gt;Tres de las cinco zonas están fuera de todo control del proyecto.&lt;br&gt;Es la razón por la que RNF-11 existe: la degradación a análisis parcial&lt;br&gt;no es una cláusula de estilo sino la consecuencia de que el sistema&lt;br&gt;dependa de siete servicios ajenos." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="460" y="640" width="390" height="95" as="geometry" />
        </mxCell>

        <mxCell id="leyenda" value="&lt;b&gt;Qué marca cada ⚠.&lt;/b&gt;&lt;br&gt;Naranja: dato de un tercero que sale de una zona hacia otra. Es lo que ampara el art. 5&lt;br&gt;inc. 2.b de la Ley 25.326, que exime del consentimiento a los datos de fuentes de acceso&lt;br&gt;público irrestricto. Quedan excluidas las cuentas protegidas y los mensajes directos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verde: la única salida que transporta datos hacia afuera del sistema.&lt;/b&gt;&lt;br&gt;Es una cesión en los términos del art. 11, y por eso sale anonimizada o agregada. La&lt;br&gt;mitigación no es una buena intención: es RF-25, de prioridad imprescindible." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="880" y="640" width="640" height="135" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
