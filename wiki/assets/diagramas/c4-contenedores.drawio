<mxfile host="app.diagrams.net" type="device">
  <diagram id="c4-contenedores" name="C4 N2 - Contenedores">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="Diagrama de contenedores (C4 — nivel 2)" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="460" height="30" as="geometry" />
        </mxCell>

        <mxCell id="limite" value="Sistema de Detección de Desinformación" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#8a949e;dashed=1;fontSize=12;fontStyle=2;spacingTop=4;fontColor=#5b6570;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="620" height="620" as="geometry" />
        </mxCell>

        <mxCell id="ext" value="&lt;b&gt;Extensión de Chrome&lt;/b&gt;&#10;&lt;i&gt;[Contenedor: JavaScript, Manifest V3]&lt;/i&gt;&#10;&#10;Content script: lee el DOM del timeline e inyecta el indicador.&#10;Service worker: agrupa pedidos y guarda el UUID anónimo.&#10;Popup: veredicto, desglose y panel de evidencia." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="120" width="270" height="130" as="geometry" />
        </mxCell>

        <mxCell id="panel" value="&lt;b&gt;Panel web&lt;/b&gt;&#10;&lt;i&gt;[Contenedor: React 19.2 · Vite · Vercel]&lt;/i&gt;&#10;&#10;Histórico del ciudadano y panel&#10;de tendencias B2B. Estático:&#10;no hace cómputo pesado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="120" width="260" height="130" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;API REST&lt;/b&gt;&#10;&lt;i&gt;[Contenedor: Python · FastAPI · Railway]&lt;/i&gt;&#10;&#10;Orquesta los cuatro módulos, resuelve el caché,&#10;autentica a los clientes B2B y aplica sus cuotas.&#10;Siempre activa: no se duerme por inactividad." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="300" width="560" height="105" as="geometry" />
        </mxCell>

        <mxCell id="ingesta" value="&lt;b&gt;Ingesta programada&lt;/b&gt;&#10;&lt;i&gt;[Contenedor: tarea programada · Railway]&lt;/i&gt;&#10;&#10;Recorre las seis fuentes oficiales respetando el crawl-delay de cada sitio,&#10;indexa los documentos nuevos y termina (RF-28). No es un servicio&#10;siempre encendido: se paga solo el tiempo de ejecución." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="425" width="560" height="100" as="geometry" />
        </mxCell>

        <mxCell id="db" value="&lt;b&gt;Base de datos&lt;/b&gt;&#10;&lt;i&gt;[Contenedor: PostgreSQL 16 + pgvector · Railway]&lt;/i&gt;&#10;&#10;Contenido analizado, evidencia, análisis y plataforma B2B.&#10;Los embeddings viven acá, en columnas vector con índice HNSW:&#10;no hay un motor vectorial separado." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#eaf1fa;strokeColor=#1b4f8f;fontSize=11;" vertex="1" parent="1">
