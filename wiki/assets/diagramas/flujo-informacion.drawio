        <mxCell id="nota1" value="&lt;b&gt;Por qué la bifurcación.&lt;/b&gt;&lt;br&gt;El flujo automático corre sobre cada tuit del scroll: si consultara&lt;br&gt;la búsqueda web y las fuentes oficiales, el costo y la latencia lo&lt;br&gt;harían inviable. Por eso el Módulo 1 va solo y los otros tres esperan&lt;br&gt;a que el ciudadano lo pida." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="nota2" value="&lt;b&gt;Los dos puntos de persistencia.&lt;/b&gt;&lt;br&gt;Tras el Módulo 1 se guarda el tuit y su score; tras el Módulo 4,&lt;br&gt;el análisis completo con su evidencia y la versión de modelo que&lt;br&gt;lo produjo. El segundo es lo que hace reproducible un veredicto&lt;br&gt;meses después (RF-27)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="90" y="775" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="nota3" value="&lt;b&gt;El análisis parcial no es un error.&lt;/b&gt;&lt;br&gt;Si una fuente externa no responde, el Módulo 4 recibe los scores&lt;br&gt;disponibles y el resultado se marca como parcial. Un veredicto&lt;br&gt;calculado sobre módulos faltantes sin avisarlo sería peor (RNF-11)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="340" height="80" as="geometry" />
        </mxCell>

      </root>
